# Axiflux DEV env (bash). Copy to env/env.dev.sh and fill in. Gitignored.
# Dev = shared integration env; Stripe TEST mode via CLI tunnel.

# export JAVA_HOME=/path/to/jdk-25

export PG_URL='jdbc:postgresql://localhost:5432/axiflux_dev'
export PG_USER='Axiflux'
export PG_PASSWORD='REPLACE_ME'
export REDIS_HOST='localhost'
export REDIS_PORT='6379'
export REDIS_PASSWORD='REPLACE_ME'

export AUTH_SECRET='REPLACE_WITH_64_HEX'

export ARK_API_KEY='ark_REPLACE_ME'
export EMBED_API_KEY='ark_REPLACE_ME'

export STRIPE_SECRET_KEY='sk_test_REPLACE_ME'
export STRIPE_PUBLISHABLE_KEY='pk_test_REPLACE_ME'
export STRIPE_WEBHOOK_SECRET='whsec_REPLACE_ME'   # from scripts/stripe-listen.sh
export AXIFLUX_PUBLIC_URL='http://localhost:8080'

# export HTTP_PROXY='http://127.0.0.1:7899'
# export HTTPS_PROXY='http://127.0.0.1:7899'
# export STRIPE_CLI=stripe

export VECTOR_PROVIDER='pgvector'
