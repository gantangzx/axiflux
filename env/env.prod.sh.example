# Tianshu PROD env (bash). Copy to env/env.prod.sh. Gitignored.
# Prefer secret-manager / container env over a file. Stripe LIVE mode, external IdP.

# export JAVA_HOME=/path/to/jdk-25

export PG_URL='jdbc:postgresql://pg.prod.internal:5432/tianshu'
export PG_USER='tianshu'
export PG_PASSWORD='REPLACE_ME'
export REDIS_HOST='redis.prod.internal'
export REDIS_PORT='6379'
export REDIS_PASSWORD='REPLACE_ME'

export AUTH_SECRET=''   # empty once IdP decoder is active
export OIDC_ISSUER_URI='https://idp.example.com/realms/tianshu'

export ARK_API_KEY='ark_REPLACE_ME'
export EMBED_API_KEY='ark_REPLACE_ME'

export STRIPE_SECRET_KEY='sk_live_REPLACE_ME'
export STRIPE_PUBLISHABLE_KEY='pk_live_REPLACE_ME'
export STRIPE_WEBHOOK_SECRET='whsec_REPLACE_ME'
export TIANSHU_PUBLIC_URL='https://app.example.com'

export EGRESS_PROXY='egress-proxy.prod.internal:3128'
export VECTOR_PROVIDER='pgvector'
