rem ============================================================================
rem Axiflux Skill Registry env (Windows). Copy to env\env.registry.bat. Gitignored.
rem ============================================================================

rem Toolchain (optional override)
rem set "JAVA_HOME=D:\software\Java\jdk-25\jdk-25.0.2"

rem ---- HTTP ----
set "REGISTRY_PORT=8090"

rem ---- PostgreSQL (独立库；首次启动 Flyway 自动建表) ----
set "REGISTRY_DB_URL=jdbc:postgresql://localhost:5432/axiflux_registry"
set "REGISTRY_DB_USER=postgres"
set "REGISTRY_DB_PASSWORD=REPLACE_ME"

rem ---- 发布令牌（必填，强随机；仍是 change-me 会拒绝启动）----
rem 生成示例：在 PowerShell 跑  [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
set "REGISTRY_PUBLISH_TOKEN=REPLACE_WITH_STRONG_RANDOM"

rem ---- 内容寻址 blob 存储 ----
set "REGISTRY_BLOB_DIR=./registry-blobs"
set "REGISTRY_MAX_ZIP_BYTES=52428800"

rem ---- Ed25519 签名 ----
set "REGISTRY_SIGNING_ENABLED=true"
set "REGISTRY_SIGNING_KEY_FILE=./registry-keys/ed25519.key"

set "REGISTRY_LOG_LEVEL=INFO"
