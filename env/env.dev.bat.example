rem ============================================================================
rem Axiflux DEV env (Windows). Copy to env\env.dev.bat and fill in. Gitignored.
rem Dev = shared integration env; Stripe TEST mode via CLI tunnel.
rem ============================================================================

rem set "JAVA_HOME=D:\software\Java\jdk-25\jdk-25.0.2"

rem ---- Infrastructure ----
set "PG_URL=jdbc:postgresql://localhost:5432/axiflux_dev"
set "PG_USER=axiflux"
set "PG_PASSWORD=REPLACE_ME"
set "REDIS_HOST=localhost"
set "REDIS_PORT=6379"
set "REDIS_PASSWORD=REPLACE_ME"

rem ---- Auth (HS256 local accounts) ----
set "AUTH_SECRET=REPLACE_WITH_64_HEX"

rem ---- LLM ----
set "ARK_API_KEY=ark_REPLACE_ME"
set "EMBED_API_KEY=ark_REPLACE_ME"

rem ---- Stripe TEST mode ----
set "STRIPE_SECRET_KEY=sk_test_REPLACE_ME"
set "STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME"
rem From `scripts\stripe-listen.bat` (changes per tunnel restart).
set "STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME"
set "AXIFLUX_PUBLIC_URL=http://localhost:8080"

rem Only if your network needs a proxy to reach Stripe (stripe CLI uses these).
rem set "HTTP_PROXY=http://127.0.0.1:7899"
rem set "HTTPS_PROXY=http://127.0.0.1:7899"
rem Full path to stripe.exe if not on PATH:
rem set "STRIPE_CLI=C:\Users\you\AppData\Local\Microsoft\WinGet\Links\stripe.exe"

set "VECTOR_PROVIDER=pgvector"
