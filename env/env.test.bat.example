rem ============================================================================
rem Axiflux TEST (staging) env (Windows). Copy to env\env.test.bat. Gitignored.
rem Production-like; Stripe TEST mode with a FIXED dashboard webhook endpoint.
rem ============================================================================

rem set "JAVA_HOME=D:\software\Java\jdk-25\jdk-25.0.2"

rem ---- Infrastructure (isolated staging hosts) ----
set "PG_URL=jdbc:postgresql://test-pg.internal:5432/axiflux_test"
set "PG_USER=axiflux"
set "PG_PASSWORD=REPLACE_ME"
set "REDIS_HOST=test-redis.internal"
set "REDIS_PORT=6379"
set "REDIS_PASSWORD=REPLACE_ME"

rem ---- Auth: HS256 fallback (token edge stays off), or test IdP ----
set "AUTH_SECRET=REPLACE_WITH_64_HEX"
rem To use a test IdP, also point the (commented) spring.security block in
rem application-test.yml at it via:
rem set "OIDC_ISSUER_URI=https://test-idp.internal/realms/axiflux"

rem ---- LLM ----
set "ARK_API_KEY=ark_REPLACE_ME"
set "EMBED_API_KEY=ark_REPLACE_ME"

rem ---- Stripe TEST mode (fixed endpoint registered in the Dashboard) ----
rem Dashboard -> Developers -> Webhooks -> Add endpoint:
rem   https://<test-host>/api/v1/billing/stripe/webhook  -> copy its signing secret.
set "STRIPE_SECRET_KEY=sk_test_REPLACE_ME"
set "STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME"
set "STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME"
set "AXIFLUX_PUBLIC_URL=https://test-app.example.com"

rem Optional egress proxy used by the agent's outbound HTTP tools.
rem set "EGRESS_PROXY=egress-proxy.internal:3128"
set "VECTOR_PROVIDER=pgvector"
