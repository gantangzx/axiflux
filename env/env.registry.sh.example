# Tianshu Skill Registry env (bash). Copy to env/env.registry.sh. Gitignored.

# export JAVA_HOME=/path/to/jdk-25

export REGISTRY_PORT='8090'

# PostgreSQL (separate DB; Flyway creates tables on first boot).
export REGISTRY_DB_URL='jdbc:postgresql://localhost:5432/tianshu_registry'
export REGISTRY_DB_USER='postgres'
export REGISTRY_DB_PASSWORD='REPLACE_ME'

# Publish token (required, strong random; "change-me" is rejected at startup).
# Generate:  openssl rand -hex 32
export REGISTRY_PUBLISH_TOKEN='REPLACE_WITH_STRONG_RANDOM'

# Content-addressed blob storage.
export REGISTRY_BLOB_DIR='./registry-blobs'
export REGISTRY_MAX_ZIP_BYTES='52428800'

# Ed25519 signing.
export REGISTRY_SIGNING_ENABLED='true'
export REGISTRY_SIGNING_KEY_FILE='./registry-keys/ed25519.key'

export REGISTRY_LOG_LEVEL='INFO'
