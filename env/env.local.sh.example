# Axiflux LOCAL env (bash). Copy to env/env.local.sh and fill in.
# Gitignored. local is the only profile that also boots without it.

# export JAVA_HOME=/path/to/jdk-25

# Infrastructure (defaults to localhost; `docker compose up -d`).
# export PG_URL='jdbc:postgresql://localhost:5432/Axiflux'
# export PG_USER='postgres'
# export PG_PASSWORD=''
# export REDIS_HOST='localhost'
# export REDIS_PORT='6379'
# export REDIS_PASSWORD=''

# Local auth / billing (off by default).
# export AUTH_ENABLED=false
# export AUTH_SECRET=''

# LLM (at least one key needed to answer chat).
export ARK_API_KEY='ark_REPLACE_ME'
export EMBED_API_KEY='ark_REPLACE_ME'

# Long-term memory (optional).
# export VECTOR_PROVIDER='none'
# export LOG_LEVEL='DEBUG'
