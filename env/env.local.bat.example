rem ============================================================================
rem Axiflux LOCAL env (Windows). Copy to env\env.local.bat and fill in.
rem This file is gitignored. local is the only profile that also boots without it.
rem ============================================================================

rem ---- Toolchain overrides (optional; defaults work on the maintainer box) ---
rem set "JAVA_HOME=D:\software\Java\jdk-25\jdk-25.0.2"

rem ---- Infrastructure (defaults to localhost; use docker-compose up -d) ------
rem set "PG_URL=jdbc:postgresql://localhost:5432/Axiflux"
rem set "PG_USER=postgres"
rem set "PG_PASSWORD="
rem set "REDIS_HOST=localhost"
rem set "REDIS_PORT=6379"
rem set "REDIS_PASSWORD="

rem ---- Local auth / billing (optional; off by default) -----------------------
rem set "AUTH_ENABLED=false"
rem set "AUTH_SECRET="

rem ---- LLM (at least one key needed to actually answer chat) -----------------
set "ARK_API_KEY=ark_REPLACE_ME"
set "EMBED_API_KEY=ark_REPLACE_ME"
rem set "OPENAI_API_KEY="
rem set "OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3"

rem ---- Long-term memory (optional) -------------------------------------------
rem set "VECTOR_PROVIDER=none"
rem set "LOG_LEVEL=DEBUG"
