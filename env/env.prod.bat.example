rem ============================================================================
rem Tianshu PROD env (Windows). Copy to env\env.prod.bat. Gitignored.
rem In production prefer injecting these via your platform's secret manager /
rem container env rather than a file. Stripe LIVE mode, external IdP.
rem ============================================================================

rem set "JAVA_HOME=D:\software\Java\jdk-25\jdk-25.0.2"

rem ---- Infrastructure ----
set "PG_URL=jdbc:postgresql://pg.prod.internal:5432/tianshu"
set "PG_USER=tianshu"
set "PG_PASSWORD=REPLACE_ME"
set "REDIS_HOST=redis.prod.internal"
set "REDIS_PORT=6379"
set "REDIS_PASSWORD=REPLACE_ME"

rem ---- Auth: external IdP (asymmetric); HS256 edge off ----
rem Secret may stay empty once the IdP decoder is active; set only if used.
set "AUTH_SECRET="
set "OIDC_ISSUER_URI=https://idp.example.com/realms/tianshu"

rem ---- LLM ----
set "ARK_API_KEY=ark_REPLACE_ME"
set "EMBED_API_KEY=ark_REPLACE_ME"

rem ---- Stripe LIVE mode (fixed production webhook endpoint) ----
set "STRIPE_SECRET_KEY=sk_live_REPLACE_ME"
set "STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME"
set "STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME"
set "TIANSHU_PUBLIC_URL=https://app.example.com"

set "EGRESS_PROXY=egress-proxy.prod.internal:3128"
set "VECTOR_PROVIDER=pgvector"
